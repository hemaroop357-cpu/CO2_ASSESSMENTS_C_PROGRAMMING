
#include <stdio.h>

int calls = 0;

int verify_card(int id) {
    calls++;
    return id % 4 == 0;
}

int main() {
    int senior, eligible;
    int concession;
    int i;

    // Method 1: Check senior and eligibility first
    calls = 0;

    for (i = 1; i <= 1000; i++) {
        senior = (i % 2 == 0);
        eligible = (i % 3 == 0);

        concession =
            (senior && eligible) || verify_card(i);
    }

    printf("Method 1 function calls = %d\n", calls);

    // Method 2: Verify card first
    calls = 0;

    for (i = 1; i <= 1000; i++) {
        senior = (i % 2 == 0);
        eligible = (i % 3 == 0);

        concession =
            verify_card(i) || (senior && eligible);
    }

    printf("Method 2 function calls = %d\n", calls);

    // Demonstrating && and &
    calls = 0;

    int a = 0;
    int b = verify_card(4);

    if (a && b)
        printf("Both true\n");

    printf("Calls after && = %d\n", calls);

    calls = 0;

    a = 0;
    b = verify_card(4);

    if (a & b)
        printf("Both true\n");

    printf("Calls after & = %d\n", calls);

    return 0;
}

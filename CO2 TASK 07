
#include <stdio.h>

unsigned long checks = 0;

int is_prime(unsigned long n) {
    checks = 0;

    if (n < 2)
        return 0;

    if (n == 2)
        return 1;

    if (n % 2 == 0) {
        checks++;
        return 0;
    }

    checks++;

    for (unsigned long i = 3; i <= n / i; i += 2) {
        checks++;

        if (n % i == 0)
            return 0;
    }

    return 1;
}

int main() {
    unsigned long numbers[] = {
        97, 100, 7919, 1000003
    };

    for (int i = 0; i < 4; i++) {
        int result = is_prime(numbers[i]);

        printf("%lu : %s : divisions = %lu\n",
            numbers[i],
            result ? "Prime" : "Not Prime",
            checks);
    }

    return 0;
}
